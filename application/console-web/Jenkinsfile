@Library('jenkinslib') 
skipRemainingStages = false
pipeline {
    agent any

    environment {
            NAME_REPO = 'backoffice-web'
            TAG = utils.setGitBranchName()
            BRANCH_NAME = utils.getGitBranchName()
            DOCKERFILE = utils.setGitBranchNameDockerfile()
            SCAN_URL="true"
            DOMAIN_NONPRD="http://admin.com"
        }
    tools { maven 'Maven_3_6_3' }
    stages{
       stage('Run Main Pipeline') {
            steps {
                script {
                    backendPipeline()  
                }
            }
        }
    }
}
